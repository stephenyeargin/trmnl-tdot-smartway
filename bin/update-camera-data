#!/usr/bin/env bash

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [[ -f "${ROOT_DIR}/.env" ]]; then
    set -a
    source "${ROOT_DIR}/.env"
    set +a
fi

URL="https://www.tdot.tn.gov/opendata/api/public/RoadwayCameras"
OUTFILE="./assets/cameras.json"

if [ -z "${TDOT_SMARTWAY_API_KEY:-}" ]; then
    echo "Must set TDOT_SMARTWAY_API_KEY" >&2
    exit 1
fi

if curl -fsSL \
    -H "ApiKey: ${TDOT_SMARTWAY_API_KEY}" \
    -o "$OUTFILE" \
    "$URL"
then
    echo "SUCCESS: downloaded to $OUTFILE"
else
    status=$?
    echo "FAILURE: curl exited with status $status" >&2

    rm -f "$OUTFILE"
    exit "$status"
fi

jq 'sort_by(.id)' $OUTFILE > tmp.json && mv tmp.json $OUTFILE
echo "SUCCESS: sorted and formatted $OUTFILE"
