<div class="layout layout--row">
  <div
    class="columns"
    data-overflow="true"
    data-overflow-max-cols-portrait="1"
    data-overflow-max-cols="3"
    data-overflow-max-cols-lg="3"
    data-overflow-counter="false"
  >
    <div class="column">
      {% for camera in cameras_filtered %}
      {% render 'camera_card', camera: camera, size: 'h--36', large_size: 'h--60' %}
      {% else %}
      <div class="text--center">
        <div><span class="title">Unable to load SmartWay data</span></div>
        <div><span class="description">Check https://smartway.tn.gov/ for updates.</span></div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke--medium" src="data:image/svg+xml;base64,{{ logo_svg | base64_encode }}" />
  <span class="title">Updated {{ 'now' | date: '%s' | plus: trmnl.user.utc_offset | date: '%-m/%-d @ %-I:%M %p' }}</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
