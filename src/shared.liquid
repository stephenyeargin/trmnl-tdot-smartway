{% assign cameras = data %}
{% assign camera_ids = trmnl.plugin_settings.custom_fields_values.tdot_camera_ids | split: ',' %}

{% assign cameras_filtered = cameras %}
{% assign has_camera_filter = false %}
{% for raw_id in camera_ids %}
{% if raw_id | strip != '' %}
{% assign has_camera_filter = true %}
{% break %}
{% endif %}
{% endfor %}

{% if has_camera_filter %}
{% assign cameras_filtered = '' | split: '' %}
{% for camera in cameras %}
{% assign camera_id = camera.id | append: '' | strip %}
{% for raw_id in camera_ids %}
{% assign target_id = raw_id | strip %}
{% if target_id != '' and camera_id == target_id %}
{% assign matched_camera = cameras | where: 'id', camera.id %}
{% assign cameras_filtered = cameras_filtered | concat: matched_camera %}
{% break %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}

{% template camera_card %}
<!-- Smaller Screen -->
<div class="item lg:hidden">
  <div class="text--center w--full">
    <img class="image image-dither rounded {{ size }}" src="{{ camera.thumbnailUrl }}" alt="{{ camera.title }}"  style="filter: grayscale(1) contrast(1.2) brightness(1.1) saturate(0.8);" />
    <p class="description description--small" data-clamp="1">{{ camera.description }}</p>
  </div>
</div>

<!-- Larger Screen -->
<div class="item hidden lg:block">
  <div class="text--center w--full">
    <img class="image image-dither rounded {{ large_size }}" src="{{ camera.thumbnailUrl }}" alt="{{ camera.title }}"  style="filter: grayscale(1) contrast(1.2) brightness(1.1) saturate(0.8);" />
    <p class="description description--small" data-clamp="1">{{ camera.description }}</p>
  </div>
</div>
{% endtemplate %}
